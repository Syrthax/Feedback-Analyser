# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
FEATHERLESS_API_KEY=
# Optional — any chat model your Featherless plan allows. Defaults to
# Qwen/Qwen2.5-72B-Instruct (Premium plan); Qwen/Qwen2.5-14B-Instruct fits Basic.
FEATHERLESS_MODEL=
HINDSIGHT_API_KEY=

# Optional — only needed by the Gatherer's `shop` source (name + location -> reviews).
# Set whichever provider you use.
GOOGLE_MAPS_API_KEY=
SERPAPI_API_KEY=
